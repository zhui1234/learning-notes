{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "build",
            "command": "C:/Users/13014/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-DLOCAL",
                "-O0",
                "-Wall",
                "-Wextra",
                "-o",
                "${fileDirname}/main.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "编译当前 C++ 文件为同目录的 main.exe（含调试信息，关闭优化）"
        },
        {
            "type": "process",
            "label": "run",
            "command": "${fileDirname}/main.exe",
            "dependsOn": "build",
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
